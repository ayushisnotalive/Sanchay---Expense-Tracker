# Neon PostgreSQL Connection URL Example
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>?sslmode=require&channel_binding=require"

# API Port (default: 3000)
PORT=3000

# Sanchay Backend JWT Secret (optional override)
SANCHAY_JWT_SECRET="generate_a_secure_random_base64_secret_here"
